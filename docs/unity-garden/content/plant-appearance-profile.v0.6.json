    "soilSampling": "actual-placement-tick before infiltration and evaporation",
    "requiredBinding": ["plantId", "cellId", "seedSourceRoundId"],
    "requiredReferences": ["birthResolvedRef+eventId", "birthPreparedRef+weatherSourceRef", "styleContentHash", "appearanceProjectionVersion"]
