  "preparedResolution": {
    "resolveBeforeOutcome": [
      "anchorCellIds",
      "sortedTargetCellIds",
      "perCellAmountsForEveryInjectionTick",
      "fieldFootprints",
      "directions",
      "seedCellIds",
      "profileContentHash",
      "mapContentHash"
    ],
    "recomputeTargetsAfterOutcome": false,
    "invalidMapOrRecipe": "rejectBeforePreparedDoNotSilentlySubstitute",
    "authoringField": "recipes[].authoringParameters",
    "snapshotField": "FaceAssignment.resolvedParameters",
    "amountMeaningByElement": {
      "water": "totalWater",
      "wind": "strengthQ at anchor before falloff and shelter",
      "light": "extraLightQ at anchor before falloff and exposure",
      "seed": "seedCount"
    },
    "unitIdByElement": {
      "water": "modelWater",
      "wind": "windStrengthQ",
      "light": "additionalLightQ",
      "seed": "seedCount"
    },
    "cellWeightsMeaningByElement": {
      "water": "equal positive integers; actual per-cell per-tick amounts are expanded into injectionSchedule",
      "wind": "falloffQ per target cell",
      "light": "falloffQ per target cell",
      "seed": "one per selected target cell"
    },
    "fieldSchedule": "startTickOffset=0; active while startTickOffset<=tickOffset<startTickOffset+durationTicks; injectionSchedule=[] for wind/light"
  },
